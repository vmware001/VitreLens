<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#0E1117</item>
        <item name="android:colorPrimaryDark">#07080B</item>
        <item name="android:colorAccent">#8FD8FF</item>
        <item name="android:windowBackground">#07080B</item>
        <item name="android:statusBarColor">#07080B</item>
        <item name="android:navigationBarColor">#07080B</item>
        <item name="android:textColorPrimary">#EEF1F6</item>
        <item name="android:textColorSecondary">#A3ABBA</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8D95A6</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">3dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">#12FFFFFF</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">#EEF1F6</item>
        <item name="android:textColorHint">#5A6274</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
