<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <size android:width="26dp" android:height="26dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#FFFFFFFF" android:endColor="#CFE8F4FF" />
            <size android:width="14dp" android:height="14dp" />
        </shape>
    </item>
</layer-list>
